{
  "info": {
    "name": "CollabDocs API",
    "description": "Collaborative Document Platform - 17 Endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "1. Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/users/me/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "users", "me", ""]
            }
          }
        },
        {
          "name": "2. Get User by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/users/1/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "users", "1", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Workspaces",
      "item": [
        {
          "name": "3. Create Workspace",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Engineering Team\",\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/workspaces/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "workspaces", ""]
            }
          }
        },
        {
          "name": "4. List Workspaces",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/workspaces/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "workspaces", ""]
            }
          }
        },
        {
          "name": "5. Get Workspace Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/workspaces/{{workspace_id}}/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "workspaces", "{{workspace_id}}", ""]
            }
          }
        },
        {
          "name": "6. Update Workspace",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Workspace Name\",\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/workspaces/{{workspace_id}}/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "workspaces", "{{workspace_id}}", ""]
            }
          }
        },
        {
          "name": "7. Delete Workspace",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/workspaces/{{workspace_id}}/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "workspaces", "{{workspace_id}}", ""]
            }
          }
        },
        {
          "name": "8. Invite Member to Workspace",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 2,\n  \"role\": \"member\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/workspaces/{{workspace_id}}/invite/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "workspaces", "{{workspace_id}}", "invite", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "9. Create Document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"API Documentation\",\n  \"content\": \"This is the API documentation...\",\n  \"status\": \"draft\",\n  \"workspace\": \"{{workspace_id}}\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/documents/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "documents", ""]
            }
          }
        },
        {
          "name": "10. List Documents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/documents/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "documents", ""]
            }
          }
        },
        {
          "name": "11. Get Document Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/documents/{{document_id}}/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "documents", "{{document_id}}", ""]
            }
          }
        },
        {
          "name": "12. Update Document",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated API Documentation\",\n  \"content\": \"Updated content here...\",\n  \"status\": \"published\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/documents/{{document_id}}/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "documents", "{{document_id}}", ""]
            }
          }
        },
        {
          "name": "13. Delete Document",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/documents/{{document_id}}/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "documents", "{{document_id}}", ""]
            }
          }
        },
        {
          "name": "14. Get Document Versions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/documents/{{document_id}}/versions/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "documents", "{{document_id}}", "versions", ""]
            }
          }
        },
        {
          "name": "15. Assign Tags to Document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tag_ids\": [\"tag-uuid-1\", \"tag-uuid-2\"]\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/documents/{{document_id}}/tags/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "documents", "{{document_id}}", "tags", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "16. Create Comment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document\": \"{{document_id}}\",\n  \"text\": \"This document needs review\",\n  \"parent\": null\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/comments/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "comments", ""]
            }
          }
        },
        {
          "name": "17. List Comments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/comments/?document_id={{document_id}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "comments", ""],
              "query": [
                {
                  "key": "document_id",
                  "value": "{{document_id}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Tags",
      "item": [
        {
          "name": "18. List Tags",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/tags/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "tags", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Audit Logs",
      "item": [
        {
          "name": "19. List Audit Logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/audit-logs/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "audit-logs", ""]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "access_token",
      "value": "your-jwt-token-here"
    },
    {
      "key": "workspace_id",
      "value": "workspace-uuid"
    },
    {
      "key": "document_id",
      "value": "document-uuid"
    }
  ]
}
